# ==============================================================================
# HOMOLOG - Configuration de Production Durcie (BPF / 21 CFR Part 11 / PSSI)
# ==============================================================================

# Mode d'exploitation multi-tenant SaaS (ou on-premise pour déploiement client dédié)
DEPLOYMENT_MODE=saas
PORT=8090

# Environnement de production strict
APP_ENV=production

# Commutateur de développement STRICTEMENT INTERDIT en production (Règle BPF / 21 CFR Part 11)
ENABLE_DEV_SWITCHER=false

# Support commercial & Pitch Deck STRICTEMENT INTERDIT en production (Sécurité & Neutralité Métier)
ENABLE_PITCH_DECK=false

# Exiger l'attribut Secure sur les cookies de session (HTTPS / TLS 1.3)
COOKIE_SECURE=true

# Sas d'accès confidentiel partenaire (Private Preview / Avant-Première Privée)
# Définir le mot de passe unique communiqué à vos clients privilégiés.
# Laisser vide ("") dès l'ouverture officielle pour désactiver le sas.
GATE_PASSCODE=ChangerCeMotDePasseUniqueVIP2026!

# Base de données PostgreSQL 16+ durcie
DATABASE_URL=postgres://homolog:homolog_secret_2026@localhost:5434/homolog?sslmode=disable

# Répertoire physique du coffre-fort CAS immuable (Content Addressable Storage dédupliqué SHA-256)
STORAGE_PATH=/var/lib/homolog/data/storage
STORAGE_TYPE=local

# Clé secrète de scellement des jetons de session (min. 64 caractères aléatoires)
JWT_SECRET=homolog-enterprise-security-token-algeria-2026-production-hardened-alcoa-plus-master-key

# Délais d'expiration et d'inactivité réglementaires BPF
SESSION_EXPIRY_MINUTES=480
IDLE_TIMEOUT_MINUTES=15
MAX_UPLOAD_MB=1024

# Serveur SMTP pour les alertes réglementaires opposables (J-180, J-90, J-30, compléments ANPP)
SMTP_HOST=smtp.pharmacie.dz
SMTP_PORT=465
SMTP_USERNAME=notifications@pharmacie.dz
SMTP_PASSWORD=ChangeThisSecretInProduction!
SMTP_FROM=homolog-notifications@pharmacie.dz

# Établissement Pharmaceutique Dépositaire Titulaire (MIPH)
ONPREM_ORG_SLUG=laboratoire-principal
ONPREM_ORG_NAME=Laboratoire Pharmaceutique National
