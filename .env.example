# Configuration Homolog - Plateforme Réglementaire ANPP & GED Pharmaceutique
DEPLOYMENT_MODE=on-premise # "on-premise" ou "saas"
PORT=8090

# Base de données PostgreSQL 16+
DATABASE_URL=postgres://homolog:homolog_secret_2026@localhost:5434/homolog?sslmode=disable

# Stockage local CAS dédupliqué SHA-256
STORAGE_PATH=./data/storage
STORAGE_TYPE=local

# Sécurité & Sessions
JWT_SECRET=homolog-enterprise-security-token-algeria-2026-production
SESSION_EXPIRY_MINUTES=480
IDLE_TIMEOUT_MINUTES=15
MAX_UPLOAD_MB=1024

# Serveur de messagerie SMTP (alertes réglementaires J-180, J-90, J-30)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@homolog.dz

# Informations établissement On-Premise
ONPREM_ORG_SLUG=laboratoire-principal
ONPREM_ORG_NAME=Laboratoire Pharmaceutique National
